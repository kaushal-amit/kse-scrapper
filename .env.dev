# ---------------------------------------------------------------------------
# Tables (after migration 002)
#   instruments        one row per instrument per market  (registry)
#   live_quotes        intraday quotes, insert-only
#   daily_bars         one OHLCV bar per symbol per day, upserted
#   order_book_levels  one row per price level, per capture
#   broker_orders      the trader's own orders, per capture
#   scrape_runs        one row per scraper execution
# The previous names remain as updatable views, so anything already reading
# stock_quotes / market_stock_snapshots / etc. keeps working.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:QwerPoiu12@trading-db.cip64s8oy79k.us-east-1.rds.amazonaws.com:5432/kse
# Set true only when the database requires TLS. Local Postgres normally does not.
DB_SSL=false

# ---------------------------------------------------------------------------
# Trading window — Asia/Kuwait, Sunday to Thursday
#
# 09:00-13:00 is what was specified. Note that Boursa Kuwait continuous trading
# runs to 13:30 and the closing auction sits after that, so this window stops
# ~30 minutes before the official close and does not capture the closing print.
# Widen END_TIME to 13:40 if the close is wanted. See README section "Trading
# window".
# ---------------------------------------------------------------------------
MARKET_TIMEZONE=Asia/Kuwait
START_TIME=09:00
END_TIME=13:30
# 0=Sunday ... 4=Thursday. Friday (5) and Saturday (6) are the Kuwaiti weekend
# and are REJECTED at startup: running on a closed day logs into the broker for
# nothing and spends one of the day's limited login attempts.
TRADING_DAYS=0,1,2,3,4

# ---------------------------------------------------------------------------
# Scrapers
# ---------------------------------------------------------------------------
# Leave UNSET to run everything. Narrowing this is how a job silently stops
# being scheduled — the boot log then shows fewer jobs than expected and there
# is nothing to notice, because a job that was never scheduled logs nothing.
ENABLED_SCRAPERS=tradingview.quotes,tradingview.history,daily.analysis,awsat.board,awsat.depth,awsat.orders

# --- Daily history (runs AFTER the close, not inside the window) ------------
# 13:30 Kuwait by default: 30 minutes past a 13:00 close, so the final prints
# have settled. It refuses to run while the market is still open.
# Leave UNSET. The default is 30 minutes after END_TIME, so it follows the
# window automatically. A hardcoded time is wrong the moment END_TIME moves:
# an after-close job scheduled inside the window is rejected on every tick and
# history never runs — silently, because a guard doing its job looks exactly
# like a job that was never scheduled. Set it and the scheduler will say so at
# startup if it falls inside the window.
# History finalises at 17:00 and the analysis runs at 08:15 the next morning.
# Both refuse to run inside the trading window; if you override either and it
# lands inside, the scheduler says so at startup.
# HISTORY_CRON=0 0 17 * * 0,1,2,3,4
# ANALYSIS_CRON=0 15 8 * * 0,1,2,3,4
# HISTORY_CRON=
HISTORY_DAYS=30
HISTORY_MAX_SYMBOLS=500
TRADINGVIEW_EXCHANGE=KSE

# stock_quotes.market is NOT NULL and part of the dedup key. TradingView has no
# market concept, so its rows need a label that cannot collide with the broker's
# 'Premier Market' / 'Main Market' — or one source would overwrite the other.
TRADINGVIEW_MARKET=TRADINGVIEW

# TradingView watchlist page holding the Boursa Kuwait symbols.
TRADINGVIEW_URL=https://www.tradingview.com/watchlists/330160510/

# --- TradingView cell identifiers ------------------------------------------
# The watchlist is addressed by TradingView's own data-qa-id attributes, not by
# class names (those are content hashes that change on every deploy). These are
# the values a working scraper of this same page uses; override only if the
# scraper reports that a different set is present on the page.
TV_QA_SYMBOL=column-symbol
TV_QA_LAST=column-last_price
TV_QA_CHANGE_PCT=column-change_percent
TV_QA_CHANGE=column-change
TV_QA_VOLUME=column-volume

# The terminal's global symbol search, used by the depth scraper. The terminal
# renders a transparent .modal-popup-overlay that intercepts pointer events, so
# overlays are cleared before every search.
# (search box selector is set below, with the ladder internals)

# AWSAT broker terminal.
# --- WHERE AWSAT DATA COMES FROM -------------------------------------------
#   server  Chromium logs in and scrapes. The ingest API REFUSES client posts.
#   client  Only the Tampermonkey scripts collect. Scheduled AWSAT jobs skip,
#           and no login attempt is spent.
#   off     Neither.
#
# One setting, not two booleans — two booleans can both be true, and the
# requirement is that the same data is never collected from both sides at once.
AWSAT_MODE=client

AWSAT_URL=https://www.awsatbroker.com
AWSAT_USER=53423
AWSAT_PASS=Qwer@Poiu12

# --- Markets ---------------------------------------------------------------
# Both markets are swept in order. Each needs a selector that brings its board
# on screen; these depend on the terminal's DOM, so find them with:
#     HEADLESS=false npm run run:once awsat.board
# Matched loosely against the terminal's own labels, so MAIN finds
# "Main Market". If nothing matches, the error lists the selectable values.
AWSAT_MARKETS=MAIN,PREMIER
AWSAT_MARKET_SEL_MAIN=
AWSAT_MARKET_SEL_PREMIER=

# --- Table selectors -------------------------------------------------------
# QUOTE any value starting with "#". dotenv reads an unquoted # as the start of
# a comment, so AWSAT_SEL_DEPTH=#depthPanel parses to an EMPTY STRING and the
# default is used instead — silently. Most real selectors are ids, so this is
# the most likely thing to write and the least likely to notice.
#   right:  AWSAT_SEL_DEPTH="#depthPanel"
#   wrong:  AWSAT_SEL_DEPTH=#depthPanel
# Each table needs its OWN selector. If two match the same element one table is
# stored as the other, so the scraper refuses to start when any two are equal.
AWSAT_SEL_BOARD=".ember-table-body-container"
# The depth panel needs its OWN container selector. It and the board are both
# .ember-table-body-container with the same row classes, so a generic lookup
# finds the BOARD and every depth capture verifies against the wrong ticker.
AWSAT_SEL_DEPTH=".quote-page-second-row-wght"
# REQUIRED for the orders scraper. There is no fallback: without a match the
# job fails rather than reading another table. A previous "last table on the
# page" fallback wrote 29 board rows into order_list_snapshots, with a company
# name in order_id and a price in symbol, and nothing errored until a decimal
# failed to cast. Find it with: HEADLESS=false npm run run:once awsat.orders
AWSAT_SEL_ORDERS="div[id^='orderList-']"

# --- Login protection ------------------------------------------------------
# Attempts are counted in tmp/awsat-login-attempts.json and SURVIVE restarts,
# crashes and worker respawns. Held one below the broker's real cap so a manual
# recovery is still possible. Reset automatically on the next trading day.
AWSAT_MAX_LOGIN_ATTEMPTS=2
AWSAT_LOGIN_COOLDOWN_MS=600000

# Order-book depth cannot cover every symbol every minute through one terminal
# session — one full sweep of ~135 symbols takes several minutes. List the
# symbols to capture, most important first. Empty means depth is skipped.
DEPTH_SYMBOLS=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# MUST be false for AWSAT: its login stalls headless with no error, which burns
# the job timeout and throws away a login attempt. On a headless server use:
#     xvfb-run -a --server-args="-screen 0 1280x800x24" npm start
HEADLESS=true

# --- Browser ---------------------------------------------------------------
# Leave unset to use Playwright's own Chromium (`npx playwright install
# chromium`). Set these when the image supplies its own browser, or when
# Playwright's CDN is unreachable from the build network.
# CHROMIUM_PATH=/usr/bin/chromium
# Chromium's zygote pre-forks renderers and needs namespace permissions many
# containers do not grant. Without this it launches, reports a version, and then
# hangs on the first page — which looks like a slow site, not a broken browser.
# CHROMIUM_SINGLE_PROCESS=true
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Client ingest API (Tampermonkey -> Server 1)
#
# Disabled entirely unless INGEST_TOKEN is set: an unauthenticated write
# endpoint accepting market data is worse than no endpoint. Use at least 24
# random characters and put it in the userscript's AUTH_TOKEN.
#
# The client never sends broker credentials and the server never asks for them —
# the userscript runs inside the trader's own already-authenticated session.
#
# Reconciliation when both collectors see the same board: each row records
# ingest_source, and precedence decides who wins —
#   awsat_client 2  (trader's own session, fewest moving parts)
#   awsat_server 1  (headless session, same socket)
#   tradingview  0  (a different venue's view)
# ---------------------------------------------------------------------------
# MUST equal AUTH_TOKEN in the userscripts. The scripts send it in the request
# BODY as `token`; the API also accepts an Authorization: Bearer header or
# x-ingest-token. A mismatch returns 401 naming which mechanism was used and
# the length received, so "bad token" does not send you looking at the network.
INGEST_TOKEN=
INGEST_PORT=8787

# Which browser origin may post. The userscripts run on the broker's page, so
# without CORS the browser discards the response and fetch() fails with
# "NetworkError" — leaving NO trace in the server log, because nothing arrives.
# '*' is the default: these endpoints are token-authenticated and write-only,
# and an allowlist that silently blocks the browser you are testing from is its
# own trap.
INGEST_ORIGIN=*
INGEST_MAX_ROWS=2000
INGEST_BODY_LIMIT=8mb


# ---------------------------------------------------------------------------
# AWSAT board collection
#
# socket  read the price WebSocket. No scrolling, no market dropdown, no
#         left/right row pairing — the socket carries every symbol in both
#         markets. This is the path to be on.
# dom     the rendered Ember table (the original path).
# both    run both, STORE the socket result, log a field-by-field diff.
#         Use this to prove parity, then switch to socket. It costs a full DOM
#         sweep every cycle, so it is not a permanent setting.
# ---------------------------------------------------------------------------
AWSAT_BOARD_MODE=both
AWSAT_SOCKET_WAIT_MS=60000
AWSAT_SOCKET_MIN_ROWS=1

# Precedence decides the CANONICAL value; every observation is still stored.
# canonical_quotes is a view over live_quotes, so nothing is deleted.
AWSAT_SOURCE_PRECEDENCE=awsat_client:2,awsat_server:1,tradingview:0

# A symbol whose PRICE has not changed within this window is flagged stale in
# the logs. It is never dropped: the last known price is still the last known
# price, and removing it turns a flat symbol into a gap.
AWSAT_STALE_AFTER_MS=300000

# --- Socket discovery ------------------------------------------------------
# `npm run awsat:discover` logs in once, watches the socket, and reports EVERY
# message type with its fields and sample frames. Use it to settle whether
# depth and the order list arrive over the socket rather than guessing a
# message type — a wrong guess writes plausible rows that are not depth.
# It consumes one login attempt, so run it deliberately.
DISCOVER_WATCH_MS=90000

# ---------------------------------------------------------------------------
# Tables (after migration 005)
#   tradingview_watchlist   TradingView board, one row per symbol per capture
#   tradingview_history     intraday history, finalised after the close
#   daily_stock_analysis    per-symbol daily analytics (COLUMNS ONLY — the
#                           calculations need their specification)
#   awsat_market_quotes     Main + Premium, from BOTH collectors
#   awsat_stock_depth       order-book levels, from both collectors
#   awsat_order_list        the trader's own orders, from both collectors
#
# The three AWSAT tables carry ingest_source IN THE KEY, so a server row and a
# client row for the same symbol at the same instant both survive and
# precedence decides the canonical value.
#
# Depth cadence (1 to 1.5 min) is measurable:
#   SELECT * FROM awsat_depth_freshness WHERE status <> 'OK';
#   SELECT * FROM awsat_depth_gaps;      -- stalls that later resumed
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# If AWSAT jobs fail with "the account was reported locked out"
#
#   npm run awsat:login-state                        show WHY it was locked
#   npm run awsat:login-state -- --reset-lockout     clear it (asks to confirm)
#   npm run awsat:login-state -- --reset-attempts    restore today's budget
#
# Clearing the flag does not unlock the account at the broker. Confirm the ID is
# usable first, or the next attempt fails and spends one of the day's two.
# ---------------------------------------------------------------------------

# --- Ladder internals (defaults match the live terminal) --------------------
# The book is a flat list of .pos-rel rows with bids and offers INTERLEAVED,
# separated by colour class (up-fore-color = bid, down-fore-color = offer) —
# not an Ember table, and not two columns.
AWSAT_SEL_DEPTH_ROW=".pos-rel"
AWSAT_SEL_DEPTH_PRICE=".cursor-pointer"
AWSAT_SEL_DEPTH_QTY=".h-right"

# The symbol search box.
AWSAT_SEL_SEARCH=".symbol-input-width input"

# Minimum captures before a day counts as a bar. A symbol seen three times
# cannot produce a meaningful high or low, and storing it anyway puts a row in
# the table that looks like every other one and is built from almost nothing.
HISTORY_MIN_CAPTURES=10

# --- Daily analysis tuning (defaults from the working engine) --------------
ANALYSIS_MIN_SWING_FILS=2.0
ANALYSIS_VOL_SPIKE_MULT=2.0
ANALYSIS_TARGET_PROFIT_FILS=2.0
ANALYSIS_FIB_LEVELS=0.236,0.382,0.500,0.618,0.786

# --- Which AWSAT markets to capture ----------------------------------------
# Boursa Kuwait has three: Premier, Main and Auction. Premier + Main is the
# TradingView watchlist exactly (39 + 98 = 137). The Auction market adds ~57
# symbols with zero prices and a null session, which inflate every count and
# every coverage check, so it is excluded by default.
AWSAT_KEEP_MARKETS=Premier Market,Main Market

# --- Which stocks the client sweeps for full depth -------------------------
# Served to the userscript from GET /depth-symbols, so the list changes without
# editing a Tampermonkey file. ORDER IS PRIORITY: the client works through it in
# order and stops at its time budget.
#
# Unset -> the day's TradingView watchlist, capped at DEPTH_MAX_SYMBOLS. A full
# ladder costs ~0.9s per symbol, so a list longer than the minute allows is one
# that silently never finishes.
DEPTH_SYMBOLS=
DEPTH_MAX_SYMBOLS=40

# --- Step 3 · signals -------------------------------------------------------
# Thresholds for the seven fast-loop checks. Defaults are the values in the
# Step 3 list; change them here rather than in code.
SIG_NO_PROTECTION_BID=20000
SIG_BUYERS_RATIO=1.6
SIG_BIG_QTY=100000
SIG_BAIT_MAX_AGE_SECS=300
SIG_TINY_TRADE_SHARES=100

# Phone delivery. A WEBHOOK, so Telegram/Pushover/ntfy/Slack all work without a
# code change. Unset = disabled; the signal still reaches signal_log, which is
# the durable record.
NOTIFY_URL=
NOTIFY_TOKEN=
# The loop runs every 20s, so an unchanged condition would buzz three times a
# minute. A phone that buzzes constantly gets silenced, and then the alert that
# mattered is missed too.
NOTIFY_MIN_GAP_MS=60000

# pace = trades_today / median_trades_by_this_hour over the last N SESSIONS
# (not calendar days — weekends and gaps make a date window return nothing).
WAKEUP_PACE_MIN=3.0
WAKEUP_TRADES_MIN=20
WAKEUP_BASELINE_DAYS=10

FAST_LOOP_CRON=
WAKEUP_CRON=
SCORE_CRON=
SCORE_MIN_MOVE_FILS=1
